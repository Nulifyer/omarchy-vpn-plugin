#!/usr/bin/env bash
set -euo pipefail

command=${1:-status}
case "$command" in
  on|off|auto|toggle|reconnect|mode|status|verify)
    exec pkexec /usr/local/libexec/nulifyer-vpn-control "$command"
    ;;
  *)
    printf 'Usage: nulifyer-vpn {on|off|auto|toggle|reconnect|mode|status|verify}\n' >&2
    exit 2
    ;;
esac

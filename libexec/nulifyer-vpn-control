#!/usr/bin/env bash
set -euo pipefail

readonly CONFIG=/etc/nulifyer-vpn/config
readonly RUN_DIR=/run/nulifyer-vpn
readonly STATE_DIR=/var/lib/nulifyer-vpn
readonly MODE_FILE=/var/lib/nulifyer-vpn/mode
readonly POLICY_LOCK=/run/nulifyer-vpn/policy.lock

[[ $EUID -eq 0 ]] || { printf 'This command must run as root.\n' >&2; exit 1; }
# shellcheck source=/dev/null
source "$CONFIG"
install -d -m 0755 "$RUN_DIR" "$STATE_DIR"

write_atomic() {
  local target=$1 value=$2 temp
  temp=$(mktemp "${target}.XXXXXX")
  printf '%s\n' "$value" > "$temp"
  chmod 0644 "$temp"
  mv -f "$temp" "$target"
}

write_status() {
  local state=$1 handshake=${2:-0} probe=${3:-unavailable}
  write_atomic "$RUN_DIR/status" "$state
$(date +%s)
$handshake
$probe"
}

status_value() {
  local state timestamp now
  state=$(sed -n '1p' "$RUN_DIR/status" 2>/dev/null || true)
  timestamp=$(sed -n '2p' "$RUN_DIR/status" 2>/dev/null || true)
  now=$(date +%s)
  case "$state" in off|waiting|connecting|connected|failed) ;; *) printf 'unknown\n'; return ;; esac
  [[ $timestamp =~ ^[0-9]+$ ]] || { printf 'unknown\n'; return; }
  (( now >= timestamp && now - timestamp <= STATUS_MAX_AGE )) || { printf 'unknown\n'; return; }
  printf '%s\n' "$state"
}

read_mode() {
  local mode
  mode=$(sed -n '1p' "$MODE_FILE" 2>/dev/null || true)
  case "$mode" in
    on|off|auto) printf '%s\n' "$mode" ;;
    *)
      if [[ $(nmcli --escape no -g connection.autoconnect connection show "$VPN_CONNECTION" 2>/dev/null || true) == yes ]]; then
        printf 'on\n'
      else
        printf 'off\n'
      fi
      ;;
  esac
}

write_mode() {
  write_atomic "$MODE_FILE" "$1"
}

vpn_active() {
  [[ $(nmcli --escape no -g GENERAL.STATE connection show "$VPN_CONNECTION" 2>/dev/null || true) == activated ]]
}

disable_vpn() {
  nmcli connection modify "$VPN_CONNECTION" connection.autoconnect no
  if vpn_active; then
    nmcli --wait 10 connection down "$VPN_CONNECTION" >/dev/null
  fi
}

set_mode() {
  local mode=$1
  write_mode "$mode"
  rm -f "$RUN_DIR/unhealthy-since"

  if [[ $mode == off ]]; then
    disable_vpn
    /usr/local/libexec/nulifyer-vpn-guard off
    write_status off
    return
  fi

  /usr/local/libexec/nulifyer-vpn-guard connecting
  write_status waiting
  if [[ $mode == on ]]; then
    nmcli connection modify "$VPN_CONNECTION" connection.autoconnect yes connection.autoconnect-retries 0
  fi
  systemctl start --no-block nulifyer-vpn-monitor.service
}

is_trusted_uuid() {
  local candidate=$1 trusted
  for trusted in $TRUSTED_UUIDS; do
    [[ $candidate == "$trusted" ]] && return 0
  done
  return 1
}

prepare_transition() {
  local uuid=${1:-} direction=${2:-up} mode
  mode=$(read_mode)
  [[ $mode != off ]] || return 0

  if [[ $direction == down || $mode == on ]] || { [[ $mode == auto ]] && ! is_trusted_uuid "$uuid"; }; then
    /usr/local/libexec/nulifyer-vpn-guard connecting
    write_status waiting
  fi
}

boot_policy() {
  local mode
  mode=$(read_mode)
  write_mode "$mode"
  if [[ $mode == off ]]; then
    /usr/local/libexec/nulifyer-vpn-guard off
    write_status off
  else
    /usr/local/libexec/nulifyer-vpn-guard connecting
    write_status waiting
  fi
}

set_off() {
  write_mode off
  disable_vpn
  /usr/local/libexec/nulifyer-vpn-guard off
  rm -f "$RUN_DIR/unhealthy-since"
  write_status off
}

verify_setup() {
  local now latest probe=unreachable
  now=$(date +%s)
  if ping -4 -q -n -c 1 -W 2 -I "$VPN_INTERFACE" -m 20054 "$VPN_DNS" >/dev/null 2>&1; then
    probe=reachable
  fi
  latest=$(wg show "$VPN_INTERFACE" latest-handshakes 2>/dev/null | awk 'BEGIN { newest=0 } $2 > newest { newest=$2 } END { print newest }' || true)
  latest=${latest:-0}
  printf 'policy_mode=%s\n' "$(read_mode)"
  printf 'networkmanager_autoconnect=%s\n' "$(nmcli --escape no -g connection.autoconnect connection show "$VPN_CONNECTION" 2>/dev/null || printf unknown)"
  printf 'status=%s\n' "$(status_value)"
  printf 'vpn_nm=%s\n' "$(nmcli --escape no -g GENERAL.STATE connection show "$VPN_CONNECTION" 2>/dev/null || printf inactive)"
  printf 'vpn_probe=%s\n' "$probe"
  (( latest > 0 )) && printf 'handshake_age_seconds=%s\n' "$((now - latest))" || printf 'handshake_age_seconds=none\n'
  printf 'guard=%s\n' "$(sed -n '1p' "$RUN_DIR/guard-mode" 2>/dev/null || printf unknown)"
  systemctl is-active dnscrypt-proxy.service | sed 's/^/dnscrypt_proxy=/'
}

command=${1:-status}
case "$command" in
  boot|on|off|auto|toggle|reconnect|prepare)
    exec 9>"$POLICY_LOCK"
    flock -x 9
    ;;
esac

case "$command" in
  boot) boot_policy ;;
  on) set_mode on ;;
  off) set_off ;;
  auto) set_mode auto ;;
  toggle)
    if [[ $(read_mode) == off ]]; then
      set_mode on
    else
      set_off
    fi
    ;;
  reconnect)
    [[ $(read_mode) != off ]] || { printf 'The VPN is off. Select Auto or On first.\n' >&2; exit 1; }
    /usr/local/libexec/nulifyer-vpn-guard connecting
    write_status connecting
    if vpn_active; then
      nmcli --wait 10 connection down "$VPN_CONNECTION" >/dev/null
    fi
    systemctl start --no-block nulifyer-vpn-monitor.service
    ;;
  prepare) prepare_transition "${2:-}" "${3:-up}" ;;
  mode) read_mode ;;
  status) status_value ;;
  verify) verify_setup ;;
  *) printf 'Usage: %s {on|off|auto|toggle|reconnect|mode|status|verify}\n' "$0" >&2; exit 2 ;;
esac

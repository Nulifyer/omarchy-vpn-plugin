#!/usr/bin/env bash
set -euo pipefail

readonly CONFIG=/etc/nulifyer-vpn/config
readonly STATE_DIR=/var/lib/nulifyer-vpn
readonly RUN_DIR=/run/nulifyer-vpn
readonly TABLE=nulifyer_vpn_guard
readonly PROBE_MARK=20054

[[ $EUID -eq 0 ]] || { printf 'This command must run as root.\n' >&2; exit 1; }
# shellcheck source=/dev/null
source "$CONFIG"
install -d -m 0755 "$STATE_DIR" "$RUN_DIR"
exec 9>"$RUN_DIR/guard.lock"
flock -x 9

write_atomic() {
  local target=$1 value=$2 temp
  temp=$(mktemp "${target}.XXXXXX")
  printf '%s\n' "$value" > "$temp"
  chmod 0644 "$temp"
  mv -f "$temp" "$target"
}

valid_ipv4() {
  [[ $1 =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
  local IFS=. octet
  for octet in $1; do (( 10#$octet <= 255 )) || return 1; done
}

refresh_endpoint() {
  local endpoint
  endpoint=$(wg show "$VPN_INTERFACE" endpoints 2>/dev/null | awk 'NR == 1 { print $2 }' | sed -E 's/:[0-9]+$//' || true)
  if valid_ipv4 "$endpoint"; then
    write_atomic "$STATE_DIR/endpoint-ip" "$endpoint"
  fi
}

trusted_active=false
for trusted in $TRUSTED_UUIDS; do
  if nmcli -t -f UUID connection show --active 2>/dev/null | grep -Fxq "$trusted"; then
    trusted_active=true
    break
  fi
done

mode=${1:-connecting}
case "$mode" in
  off|connecting|ready) ;;
  *) printf 'Usage: %s {off|connecting|ready}\n' "$0" >&2; exit 2 ;;
esac

if [[ $mode == off ]]; then
  nft list table inet "$TABLE" >/dev/null 2>&1 && nft delete table inet "$TABLE"
  write_atomic "$RUN_DIR/guard-mode" off
  exit 0
fi

refresh_endpoint
endpoint=$(sed -n '1p' "$STATE_DIR/endpoint-ip" 2>/dev/null || true)
valid_ipv4 "$endpoint" || endpoint=127.0.0.1

trusted_rules=''
if [[ $trusted_active == true ]]; then
  trusted_rules="ip daddr $TRUSTED_DNS udp dport 53 accept
    ip daddr $TRUSTED_DNS tcp dport 53 accept"
fi

ready_rule=''
[[ $mode == ready ]] && ready_rule="oifname \"$VPN_INTERFACE\" accept"
fingerprint="$mode:$endpoint:$trusted_active:$VPN_INTERFACE:$VPN_ENDPOINT_PORT:$VPN_DNS:$TRUSTED_DNS:$DOH_IPV4"
if [[ $(sed -n '1p' "$RUN_DIR/guard-fingerprint" 2>/dev/null || true) == "$fingerprint" ]] && nft list table inet "$TABLE" >/dev/null 2>&1; then
  exit 0
fi

{
  nft list table inet "$TABLE" >/dev/null 2>&1 && printf 'delete table inet %s\n' "$TABLE"
  cat <<EOF
table inet $TABLE {
  chain output {
    type filter hook output priority -50; policy accept;
    oifname "lo" accept
    udp sport 68 udp dport 67 accept
    meta nfproto ipv6 udp sport 546 udp dport 547 accept
    meta nfproto ipv6 icmpv6 type { nd-router-solicit, nd-neighbor-solicit, nd-neighbor-advert } accept
    ip daddr { $DOH_IPV4 } tcp dport 443 accept
    ip daddr $endpoint udp dport $VPN_ENDPOINT_PORT accept
    $trusted_rules
    oifname "$VPN_INTERFACE" ip daddr $VPN_DNS icmp type echo-request accept
    meta mark $PROBE_MARK oifname "$VPN_INTERFACE" accept
    $ready_rule
    counter drop
  }
}
EOF
} | nft -f -

write_atomic "$RUN_DIR/guard-mode" "$mode"
write_atomic "$RUN_DIR/guard-fingerprint" "$fingerprint"

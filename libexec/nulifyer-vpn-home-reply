#!/usr/bin/env bash
set -euo pipefail

readonly CONFIG=/etc/nulifyer-vpn/config
readonly LOCK_FILE=/run/nulifyer-vpn/home-reply.lock
readonly ENDPOINT_RULE_FILE=/run/nulifyer-vpn/endpoint-reply-ip

# shellcheck source=/dev/null
source "$CONFIG"
mkdir -p /run/nulifyer-vpn
exec 9>"$LOCK_FILE"
flock -x 9

# Hairpin NAT changes the reply source from the public endpoint to the home
# router, so this exact reply must precede UFW's INVALID-packet drop.
rule=(-i "${TRUSTED_INTERFACE:-}" -p udp -s "$TRUSTED_GATEWAY" --sport "$VPN_ENDPOINT_PORT" --dport "$VPN_CLIENT_PORT" -j ACCEPT)

remove_rule() {
  while iptables -C ufw-before-input "${rule[@]}" >/dev/null 2>&1; do
    iptables -D ufw-before-input "${rule[@]}"
  done
}

iptables -nL ufw-before-input >/dev/null 2>&1 || exit 0

valid_ipv4() {
  [[ $1 =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
  local IFS=. octet
  for octet in $1; do (( 10#$octet <= 255 )) || return 1; done
}

endpoint_rule() {
  local operation=$1 endpoint=$2
  iptables "$operation" ufw-before-input "${@:3}" \
    -p udp -s "$endpoint" --sport "$VPN_ENDPOINT_PORT" --dport "$VPN_CLIENT_PORT" \
    -m comment --comment nulifyer-vpn-endpoint-reply -j ACCEPT
}

remove_endpoint_rule() {
  local endpoint
  endpoint=$(sed -n '1p' "$ENDPOINT_RULE_FILE" 2>/dev/null || true)
  if valid_ipv4 "$endpoint"; then
    while endpoint_rule -C "$endpoint" >/dev/null 2>&1; do
      endpoint_rule -D "$endpoint"
    done
  fi
  rm -f "$ENDPOINT_RULE_FILE"
}

if [[ ${1:-sync} == remove ]]; then
  remove_rule
  remove_endpoint_rule
  exit 0
fi

# During startup, conntrack can reject handshake replies before ufw-user-input.
# Admit only the VPN endpoint's UDP replies, before the INVALID-packet drop.
mode=$(sed -n '1p' /var/lib/nulifyer-vpn/mode 2>/dev/null || true)
if [[ $mode == on || $mode == auto ]]; then
  endpoint=$(wg show "$VPN_INTERFACE" endpoints 2>/dev/null | awk 'NR == 1 { print $2 }' | sed -E 's/:[0-9]+$//' || true)
  if ! valid_ipv4 "$endpoint"; then
    endpoint=$(sed -n '1p' /var/lib/nulifyer-vpn/endpoint-ip 2>/dev/null || true)
  fi
  if valid_ipv4 "$endpoint"; then
    previous=$(sed -n '1p' "$ENDPOINT_RULE_FILE" 2>/dev/null || true)
    [[ $previous == "$endpoint" ]] || remove_endpoint_rule
    endpoint_rule -C "$endpoint" >/dev/null 2>&1 || endpoint_rule -I "$endpoint" 3
    printf '%s\n' "$endpoint" > "$ENDPOINT_RULE_FILE"
  fi
else
  remove_endpoint_rule
fi

trusted_active=false
for trusted in $TRUSTED_UUIDS; do
  if nmcli -t -f UUID connection show --active 2>/dev/null | grep -Fxq "$trusted"; then
    trusted_active=true
    break
  fi
done

if [[ $trusted_active == true && -n ${TRUSTED_INTERFACE:-} && -n ${TRUSTED_GATEWAY:-} ]]; then
  iptables -C ufw-before-input "${rule[@]}" >/dev/null 2>&1 || \
    iptables -I ufw-before-input 3 "${rule[@]}"
else
  remove_rule
fi

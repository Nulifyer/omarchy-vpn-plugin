#!/usr/bin/env bash
set -euo pipefail

readonly CONFIG=/etc/nulifyer-vpn/config
readonly RUN_DIR=/run/nulifyer-vpn
readonly MODE_FILE=/var/lib/nulifyer-vpn/mode
readonly POLICY_LOCK=/run/nulifyer-vpn/policy.lock
readonly PROBE_MARK=20054

[[ $EUID -eq 0 ]] || { printf 'This command must run as root.\n' >&2; exit 1; }
# shellcheck source=/dev/null
source "$CONFIG"
install -d -m 0755 "$RUN_DIR"
exec 9>"$POLICY_LOCK"
flock -x 9

write_atomic() {
  local target=$1 value=$2 temp
  temp=$(mktemp "${target}.XXXXXX")
  printf '%s\n' "$value" > "$temp"
  chmod 0644 "$temp"
  mv -f "$temp" "$target"
}

write_status() {
  local state=$1 handshake=${2:-0} probe=${3:-unavailable}
  write_atomic "$RUN_DIR/status" "$state
$(date +%s)
$handshake
$probe"
}

has_upstream() {
  ip -4 route show default 2>/dev/null | awk -v vpn="$VPN_INTERFACE" '$0 !~ ("dev " vpn "( |$)") { found=1 } END { exit !found }'
}

upstream_uuid() {
  local iface
  iface=$(ip -4 route show default 2>/dev/null | awk -v vpn="$VPN_INTERFACE" '$0 !~ ("dev " vpn "( |$)") { for (i=1; i<=NF; i++) if ($i == "dev") { print $(i+1); exit } }')
  [[ -n $iface ]] || return 0
  nmcli --escape no -g GENERAL.CON-UUID device show "$iface" 2>/dev/null | sed -n '1p'
}

is_trusted_uuid() {
  local candidate=$1 trusted
  for trusted in $TRUSTED_UUIDS; do
    [[ -n $candidate && $candidate == "$trusted" ]] && return 0
  done
  return 1
}

read_mode() {
  local mode
  mode=$(sed -n '1p' "$MODE_FILE" 2>/dev/null || true)
  case "$mode" in
    on|off|auto) printf '%s\n' "$mode" ;;
    *) printf 'off\n' ;;
  esac
}

vpn_active() {
  [[ $(nmcli --escape no -g GENERAL.STATE connection show "$VPN_CONNECTION" 2>/dev/null || true) == activated ]]
}

set_autoconnect() {
  local value=$1
  if [[ $(nmcli --escape no -g connection.autoconnect connection show "$VPN_CONNECTION" 2>/dev/null || true) != "$value" ]]; then
    nmcli connection modify "$VPN_CONNECTION" connection.autoconnect "$value" connection.autoconnect-retries 0
  fi
}

deactivate_vpn() {
  if vpn_active; then
    nmcli --wait 10 connection down "$VPN_CONNECTION" >/dev/null
  fi
}

write_unhealthy_status() {
  local now=$1 latest=${2:-0} probe=${3:-unreachable} since
  if [[ ! -r $RUN_DIR/unhealthy-since ]]; then
    write_atomic "$RUN_DIR/unhealthy-since" "$now"
  fi
  since=$(<"$RUN_DIR/unhealthy-since")
  if (( now - since >= CONNECT_TIMEOUT )); then
    write_status failed "$latest" "$probe"
  else
    write_status connecting "$latest" "$probe"
  fi
}

seed_unresolved_endpoint() {
  local endpoint cached peer octet
  endpoint=$(wg show "$VPN_INTERFACE" endpoints 2>/dev/null | awk 'NR == 1 { print $2 }' || true)
  [[ -z $endpoint || $endpoint == '(none)' ]] || return 0
  cached=$(sed -n '1p' /var/lib/nulifyer-vpn/endpoint-ip 2>/dev/null || true)
  [[ $cached =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 0
  local IFS=.
  for octet in $cached; do (( 10#$octet <= 255 )) || return 0; done
  peer=$(wg show "$VPN_INTERFACE" peers 2>/dev/null | sed -n '1p' || true)
  [[ -n $peer ]] || return 0
  wg set "$VPN_INTERFACE" peer "$peer" endpoint "$cached:$VPN_ENDPOINT_PORT"
  printf 'Seeded unresolved WireGuard endpoint from the local cache.\n'
}

/usr/local/libexec/nulifyer-vpn-home-reply

mode=$(read_mode)

if [[ $mode == off ]]; then
  set_autoconnect no
  deactivate_vpn
  /usr/local/libexec/nulifyer-vpn-guard off
  rm -f "$RUN_DIR/unhealthy-since"
  write_status off
  exit 0
fi

if ! has_upstream; then
  /usr/local/libexec/nulifyer-vpn-guard connecting
  if [[ $mode == auto ]]; then
    set_autoconnect no
    deactivate_vpn
  else
    set_autoconnect yes
  fi
  rm -f "$RUN_DIR/unhealthy-since"
  write_status waiting
  exit 0
fi

current_upstream_uuid=$(upstream_uuid)
if [[ $mode == auto ]] && is_trusted_uuid "$current_upstream_uuid"; then
  /usr/local/libexec/nulifyer-vpn-guard connecting
  set_autoconnect no
  deactivate_vpn
  /usr/local/libexec/nulifyer-vpn-guard off
  rm -f "$RUN_DIR/unhealthy-since"
  write_status off
  exit 0
fi

if ! vpn_active; then
  /usr/local/libexec/nulifyer-vpn-guard connecting
  set_autoconnect yes
  write_status connecting
  if ! nmcli --wait 15 connection up "$VPN_CONNECTION" >/dev/null 2>&1; then
    write_unhealthy_status "$(date +%s)"
    exit 0
  fi
else
  set_autoconnect yes
fi

seed_unresolved_endpoint
# Activation can resolve a different endpoint from the one cached at boot.
/usr/local/libexec/nulifyer-vpn-home-reply

now=$(date +%s)
probe_ok=false
if ping -4 -q -n -c 1 -W 2 -I "$VPN_INTERFACE" -m "$PROBE_MARK" "$VPN_DNS" >/dev/null 2>&1; then
  probe_ok=true
fi
latest=$(wg show "$VPN_INTERFACE" latest-handshakes 2>/dev/null | awk 'BEGIN { newest=0 } $2 > newest { newest=$2 } END { print newest }')
latest=${latest:-0}

if [[ $probe_ok == true ]] && (( latest > 0 && now - latest <= HANDSHAKE_MAX_AGE )); then
  /usr/local/libexec/nulifyer-vpn-guard ready
  rm -f "$RUN_DIR/unhealthy-since"
  write_status connected "$latest" reachable
  exit 0
fi

/usr/local/libexec/nulifyer-vpn-guard connecting
write_unhealthy_status "$now" "$latest" "$([[ $probe_ok == true ]] && printf reachable || printf unreachable)"

# NetworkManager activation does not imply a working handshake. Retry a stuck
# tunnel without releasing the guard or changing the user's persistent mode.
since=$(<"$RUN_DIR/unhealthy-since")
last_retry=$(cat "$RUN_DIR/last-retry" 2>/dev/null || printf 0)
if (( now - since >= CONNECT_TIMEOUT && now - last_retry >= 60 )); then
  write_atomic "$RUN_DIR/last-retry" "$now"
  printf 'Restarting an unhealthy WireGuard tunnel with the guard closed.\n'
  deactivate_vpn
fi

// Generated during system setup for one local user.
polkit.addRule(function(action, subject) {
    if (action.id === "org.freedesktop.policykit.exec" &&
        action.lookup("program") === "/usr/local/libexec/nulifyer-vpn-control" &&
        subject.local && subject.active && subject.user === @USER_JSON@) {
        return polkit.Result.YES;
    }
});

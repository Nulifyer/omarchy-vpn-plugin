[Unit]
Description=Allow WireGuard endpoint and trusted-network hairpin replies through UFW
After=ufw.service
Wants=ufw.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/nulifyer-vpn-home-reply
ExecStop=/usr/local/libexec/nulifyer-vpn-home-reply remove
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
